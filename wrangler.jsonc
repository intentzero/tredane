{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tredane-dev",
  "main": "./src/worker/index.ts",
  // Máximo suportado pelo workerd local do vite-plugin (workerd 1.20261012.x → 2026-10-19).
  // Não antecipar a data do calendário além do binário instalado — bloqueia `npm run dev`.
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tredane-dev",
      // Apenas para D1 local. Substituir por ID real após provisionar no Cloudflare.
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "db/migrations"
    }
  ]
}
