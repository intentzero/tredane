{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tredane-dev",
  "main": "./src/worker/index.ts",
  // Máximo suportado pelo workerd local do vite-plugin (workerd 1.20261012.x → 2026-10-19).
  // Não antecipar a data do calendário além do binário instalado — bloqueia `npm run dev`.
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "development",
    // synthetic: Bearer synth:<user_id> (sem segredos). Trocar para clerk + .dev.vars com chaves reais.
    "AUTH_MODE": "synthetic",
    "CLERK_AUTHORIZED_PARTIES": "http://localhost:5173",
    // #25: links de convite; EMAIL_TRANSPORT=simulated até o provedor ser aprovado.
    "APP_BASE_URL": "http://localhost:5173",
    "EMAIL_TRANSPORT": "simulated",
    // #31/#32: Meta synthetic até gates (#18); verify token / secret via .dev.vars em live.
    "META_MODE": "synthetic",
    // #42: Web Push — synthetic não chama FCM/APNs; live exige VAPID_* em secrets.
    "PUSH_MODE": "synthetic"
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tredane-dev",
      // Apenas para D1 local. Substituir por ID real após provisionar no Cloudflare.
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "db/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CLINIC",
        "class_name": "ClinicDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-f0-clinic-do",
      "new_sqlite_classes": ["ClinicDurableObject"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "tredane-attachments-dev"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INBOUND_EVENTS",
        "queue": "tredane-inbound-dev"
      }
    ],
    "consumers": [
      {
        "queue": "tredane-inbound-dev",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "tredane-inbound-dlq-dev",
        "retry_delay": 30
      }
    ]
  },
  // Bindings não são herdados: staging/prod repetem o contrato completo.
  // Placeholders 0000…00aa / 0000…00ff e UNPROVISIONED_* são recusados por
  // `npm run check:env -- staging|production` antes de qualquer deploy.
  "env": {
    "staging": {
      "name": "tredane-dev-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "AUTH_MODE": "clerk"
        // CLERK_PUBLISHABLE_KEY + CLERK_AUTHORIZED_PARTIES via dashboard/vars;
        // CLERK_SECRET_KEY via `wrangler secret put` — ver f1-clerk-auth.md
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tredane-staging",
          "database_id": "00000000-0000-4000-a000-0000000000aa",
          "migrations_dir": "db/migrations"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "CLINIC",
            "class_name": "ClinicDurableObject"
          }
        ]
      },
      "r2_buckets": [
        {
          "binding": "ATTACHMENTS",
          "bucket_name": "tredane-attachments-staging"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "INBOUND_EVENTS",
            "queue": "tredane-inbound-staging"
          }
        ],
        "consumers": [
          {
            "queue": "tredane-inbound-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "tredane-inbound-dlq-staging",
            "retry_delay": 30
          }
        ]
      }
    },
    "production": {
      "name": "tredane-dev-production",
      "vars": {
        "ENVIRONMENT": "production",
        "AUTH_MODE": "clerk"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tredane-production",
          "database_id": "00000000-0000-4000-a000-0000000000ff",
          "migrations_dir": "db/migrations"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "CLINIC",
            "class_name": "ClinicDurableObject"
          }
        ]
      },
      "r2_buckets": [
        {
          "binding": "ATTACHMENTS",
          "bucket_name": "tredane-attachments-production"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "INBOUND_EVENTS",
            "queue": "tredane-inbound-production"
          }
        ],
        "consumers": [
          {
            "queue": "tredane-inbound-production",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "tredane-inbound-dlq-production",
            "retry_delay": 30
          }
        ]
      }
    }
  }
}
