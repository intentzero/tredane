{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Config isolada para createTestHarness (sem assets SPA).
  // Não usar para deploy — ver wrangler.jsonc + docs/implementation/environments.md.
  "name": "tredane-dev",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-10-19",
  "vars": {
    "ENVIRONMENT": "development",
    "AUTH_MODE": "synthetic",
    "CLERK_AUTHORIZED_PARTIES": "http://localhost:5173",
    "APP_BASE_URL": "http://localhost:5173",
    "EMAIL_TRANSPORT": "simulated",
    "META_MODE": "synthetic"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tredane-dev",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "db/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CLINIC",
        "class_name": "ClinicDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-f0-clinic-do",
      "new_sqlite_classes": ["ClinicDurableObject"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "tredane-attachments-dev"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INBOUND_EVENTS",
        "queue": "tredane-inbound-dev"
      }
    ],
    "consumers": [
      {
        "queue": "tredane-inbound-dev",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "dead_letter_queue": "tredane-inbound-dlq-dev",
        "retry_delay": 1
      }
    ]
  },
  "workflows": [
    {
      "name": "tredane-tenant-purge-dev",
      "binding": "TENANT_PURGE",
      "class_name": "TenantPurgeWorkflow"
    }
  ]
}
