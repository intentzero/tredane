{
  "name": "tredane-site",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "build:staging": "SITE_URL=https://staging.tredane.com PUBLIC_NOINDEX=1 astro build",
    "build:production": "SITE_URL=https://tredane.com astro build",
    "deploy:staging": "npm run build:staging && wrangler deploy --env staging",
    "deploy:production": "npm run build:production && wrangler deploy --env production"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/geist": "^5.3.0",
    "astro": "^7.4.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "wrangler": "4.136.1"
  }
}
