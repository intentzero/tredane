---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import { Image } from 'astro:assets'
// Capturas PROVISÓRIAS (site/capturas/gerar.sh): trocar pelas do aplicativo real com o seed da landing.
import shotConversas from '../assets/app/conversas.png'
import shotConversa from '../assets/app/conversa.png'
import shotAgenda from '../assets/app/agenda.png'
// Antes de publicar, preencher os itens [A DEFINIR] (DEC-044, LP-AC-05).
// Toda afirmação desta página precisa de uma decisão confirmada (docs/product/landing.md).
// Mensagem de 05/11/2026: a clínica cresce e a Tredane é a parceira do lado (docs/product/landing.md).
// Endereços só aparecem quando configurados com valor real, sem .example (padrão do PR #547).
const isReal = (v?: string) => Boolean(v && !v.includes('.example'))
const appUrl = import.meta.env.PUBLIC_APP_URL
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL
// Link wa.me do WhatsApp do próprio Tredane, já com a mensagem pronta (revisão de 04/11/2026).
// Exemplo: https://wa.me/55DDDNUMERO?text=Quero%20conhecer%20o%20Tredane
const whatsappUrl = import.meta.env.PUBLIC_WHATSAPP_URL
const hasAppUrl = isReal(appUrl)
const hasContact = isReal(contactEmail)
const hasWhatsapp = isReal(whatsappUrl)
// Sem WhatsApp configurado, os botões levam ao bloco do piloto.
const ctaHref = hasWhatsapp ? whatsappUrl : '#piloto'
// Telas do aplicativo: a conversa e a agenda na abertura; Conversas em «Feito para equipe» (13/11/2026).
const shots = [
 { src: shotConversas, alt: 'Tela Conversas do aplicativo: Júlia Santos no topo com «Precisa de alguém», Lívia Moraes agendada para sexta às 10:00 e marcada pela IA, Carla Dias com a IA e Bianca Lima com a atendente Ana.' },
 { src: shotConversa, alt: 'Tela da conversa com Lívia Moraes: pergunta de preço, resposta automática com valor e duração, pedido de sexta de manhã e proposta de sexta 06/11 às 10:00 confirmada pela cliente.' },
 { src: shotAgenda, alt: 'Tela da agenda de sexta, 6 de novembro: Lívia Moraes às 10:00 na Sala 1, marcada pela IA; intervalo de preparo; Sala 2 bloqueada para manutenção do aparelho; horário livre às 11:00.' },
]
const [shotListAlt, shotChatAlt, shotAgendaAlt] = shots.map((s) => s.alt)
// Motivos de fundo (13/11/2026): linhas de seda e flor de oito pétalas, sempre decorativos.
const silkWarm = [560, 592, 624, 656].map((y) => `<path d="M-100 ${y} C 200 ${y - 140}, 420 ${y + 140}, 760 ${y - 20} S 1300 ${y - 200}, 1560 ${y - 60}"/>`).join('')
const silkCool = [688, 720, 752].map((y) => `<path d="M-100 ${y} C 200 ${y - 124}, 420 ${y + 124}, 760 ${y - 20} S 1300 ${y - 184}, 1560 ${y - 60}"/>`).join('') + [150, 182].map((y) => `<path d="M-100 ${y} C 260 ${y - 110}, 520 ${y + 90}, 860 ${y - 40} S 1320 ${y - 130}, 1560 ${y - 30}"/>`).join('')
const petal = 'M200 200 C 150 120, 150 60, 200 20 C 250 60, 250 120, 200 200Z'
const flower = [0, 45, 90, 135, 180, 225, 270, 315].map((a) => `<path d="${petal}" transform="rotate(${a} 200 200)"/>`).join('')
// Garantias de atendimento, agora em três (DEC-061, DEC-083, DEC-104, DEC-107 a DEC-115).
const trust = [
 { icon: 'book' as const, title: 'Fala o que você ensinou.', text: 'Preço, duração e explicação são os seus. O que ela não sabe, pergunta para a equipe.' },
 { icon: 'pointer' as const, title: 'Quem escolhe o horário é a cliente.', text: 'Só marca quando ela toca em Confirmar. Um «pode ser» escrito não marca.' },
 { icon: 'bell' as const, title: 'Na hora certa, chama a sua equipe.', text: 'Assunto de saúde, remarcação ou «quero falar com alguém»: passa para uma pessoa.' },
]
const faq = [
 { q: 'Isso me ajuda a faturar mais?', a: 'A ideia é essa: cada cliente recebe o preço e os horários enquanto ainda está com vontade de marcar. E o sinal por Pix segura o horário nos serviços que você escolher.' },
 { q: 'Funciona com várias profissionais e salas?', a: 'Funciona. A agenda confere profissional, sala e intervalo antes de mostrar qualquer horário.' },
 { q: 'Preciso trocar o número da clínica?', a: 'O Tredane usa a API oficial do WhatsApp Business. Conversamos sobre o número antes de conectar, e a conexão é feita pela própria clínica, no fluxo oficial da Meta, com a nossa ajuda.' },
 { q: 'O que a IA responde sozinha?', a: 'O que é rotina: preço, duração, explicação do serviço e horários livres, com as frases e o cadastro da clínica. Saúde, remarcação, cancelamento e qualquer pedido para falar com alguém vão para a equipe.' },
 { q: 'Funciona no computador?', a: 'Sim, no navegador. O desenho foi pensado primeiro para o celular, onde a equipe mais atende.' },
 { q: 'Quanto custa?', a: '[PREÇO E CONDIÇÕES A DEFINIR]' },
]
---
<Base
 title="Tredane — a parceira da sua clínica no WhatsApp"
 description="Sua clínica cresce. E você tem uma parceira do lado. O Tredane responde cada cliente no WhatsApp com o seu preço, mostra os horários livres e marca quando ela confirma."
>
<a class="skip" href="#conteudo">Ir para o conteúdo</a>

<header class="topbar">
<div class="wrap">
<a class="brand" href="#topo" aria-label="Tredane, início"><img src="/tredane-horizontal-escuro.svg" alt="Tredane" width="120" height="26" /></a>
<nav class="nav" aria-label="Seções">
<a href="#ajuda">Como ajuda</a>
<a href="#conversa">Na prática</a>
<a href="#pix">Sinal Pix</a>
<a href="#confianca">Confiança</a>
</nav>
<div class="top-actions">
{hasAppUrl && <a class="top-link" href={appUrl}>Entrar</a>}
<a class="btn btn-apricot btn-sm" href={ctaHref}>{hasWhatsapp ? <><span class="cta-long">Conversar no WhatsApp</span><span class="cta-short">WhatsApp</span></> : 'Conhecer o piloto'}</a>
</div>
</div>
</header>

<main id="conteudo">
<section id="topo" class="hero">
<span class="aurora" aria-hidden="true"><i></i><i></i><i></i></span>
<svg class="silk" aria-hidden="true" viewBox="0 0 1440 800" preserveAspectRatio="xMidYMid slice" fill="none" stroke-linecap="round" stroke-width="1.2"><g stroke="#F2B596" opacity=".3" set:html={silkWarm} /><g stroke="#9FD3D1" opacity=".26" set:html={silkCool} /></svg>
<div class="wrap hero-grid">
<div class="hero-copy">
<p class="chip"><span class="dot"></span><span class="chip-long">Piloto aberto · clínicas de estética e depilação</span><span class="chip-short">Piloto aberto · estética e depilação</span></p>
<h1 class="h1">Sua clínica cresce. <em>E você tem uma parceira do lado.</em></h1>
<p class="lead">O Tredane responde cada cliente no WhatsApp com o seu preço, mostra os horários livres e marca quando ela confirma. Você só vê a agenda enchendo.</p>
<div class="cta-row">
<a class="btn btn-apricot" href={ctaHref}>{hasWhatsapp && <Icon name="message" size={20} stroke={2.2} />}Quero minha agenda cheia</a>
<a class="hero-link" href="#conversa">Ver na prática</a>
</div>
{hasWhatsapp && <p class="hero-note">Você fala com o atendimento do Tredane como uma cliente falaria. Quem constrói o produto responde quando você pedir.</p>}
</div>

<div class="hero-stage">
<span class="rings" aria-hidden="true"></span>
<div class="stage-phone front"><Image src={shotConversa} alt={shotChatAlt} widths={[270, 540]} sizes="(max-width: 640px) 190px, 270px" width={270} height={559} format="webp" quality={80} loading="eager" decoding="async" /></div>
<div class="stage-phone back"><Image src={shotAgenda} alt={shotAgendaAlt} widths={[240, 480]} sizes="(max-width: 640px) 170px, 240px" width={240} height={497} format="webp" quality={80} loading="eager" decoding="async" /></div>
<p class="hero-toast" aria-hidden="true"><span class="toast-ok"><Icon name="check" size={18} stroke={2.4} /></span><span><b>Lívia confirmou</b><small>sexta · 10:00 · Sala 1</small></span></p>
</div>
</div>
<div class="wrap">
<ul class="proof plain">
<li>WhatsApp oficial</li>
<li>O preço é sempre o seu</li>
<li>Sinal por Pix direto na sua conta</li>
</ul>
<p class="fine">Telas do aplicativo, com nomes e valores fictícios.</p>
</div>
</section>

<section id="ajuda" class="section bg-cream glow-corner">
<svg class="flower" aria-hidden="true" viewBox="0 0 400 400" fill="none" stroke-width="1.2" set:html={flower} />
<div class="wrap" style="display: flex; flex-direction: column; gap: 48px;">
<div class="head reveal">
<p class="eyebrow">Como o Tredane ajuda</p>
<h2 class="h3s">Você cuida da clínica. A gente cuida da conversa.</h2>
</div>
<ul class="plain help-list help-bento">
<li class="help help-feature reveal">
<div class="help-copy"><span class="oi"><Icon name="message" size={22} /></span><h3>Cliente perguntou, cliente marcou.</h3><p>Ela pergunta o preço e já recebe a resposta, com os horários livres. Escolhe, confirma, pronto.</p></div>
<div class="mini-chat" aria-hidden="true"><span class="mc-in">Quanto fica axila e meia perna?</span><span class="mc-out">R$ [valor], cerca de 40 min. Quer ver os horários livres?</span><span class="mc-slots"><span>sex 10:00</span><span>sex 11:00</span><span>sáb 09:30</span></span></div>
</li>
<li class="card help reveal"><span class="oi"><Icon name="calendar" size={22} /></span><h3>Cresce sem virar bagunça.</h3><p>Mais profissionais, mais salas, mais serviços. A agenda confere tudo antes de marcar.</p><span class="help-tags" aria-hidden="true"><span><Icon name="check" size={14} stroke={2.6} />Profissional</span><span><Icon name="check" size={14} stroke={2.6} />Sala</span><span><Icon name="check" size={14} stroke={2.6} />Intervalo</span></span></li>
<li class="card help reveal"><span class="oi warm"><Icon name="users" size={22} /></span><h3>Sua equipe cuidando de gente.</h3><p>A pergunta repetida fica com a parceira. A equipe fica com quem está na cadeira.</p><span class="help-person" aria-hidden="true"><span class="hp-av">JS</span><span><b>Júlia Santos</b><small>Precisa de alguém</small></span></span></li>
</ul>
</div>
</section>

<section id="conversa" class="section bg-dots">
<div class="wrap" style="display: flex; flex-direction: column; gap: 48px;">
<div class="story-head reveal">
<div class="stack" style="gap: 16px;">
<p class="eyebrow">Na prática</p>
<h2 class="h2">Do «oi» ao horário marcado em poucos toques.</h2>
</div>
<p class="lead">Uma cliente, do primeiro contato ao horário na sua agenda. Ninguém da equipe precisou digitar nada.</p>
</div>
<ol class="grid4 plain scene-pratica">
<li class="reveal card story"><span class="story-t"><b>1</b></span><h3>A Lívia chama no WhatsApp</h3><p>Quer saber o preço de axila e meia perna.</p><span class="bubble-in">Quanto fica axila e meia perna?</span></li>
<li class="reveal card story"><span class="story-t"><b>2</b></span><h3>Recebe o seu preço na hora</h3><p>Do jeitinho que você cadastrou. Sem preço cadastrado, a pergunta vai para a equipe.</p><span class="bubble-out">Na mesma visita: R$ [valor], cerca de 40 min.</span></li>
<li class="reveal card story story-key"><span class="story-t"><b>3</b></span><h3>Escolhe e toca em Confirmar</h3><p>Só aparece horário que cabe de verdade: profissional, sala e intervalo.</p><span class="mini-proposal"><span><small>Proposta de horário</small><b>sexta 06/11 · 10:00</b></span><span class="mini-ok">Confirmar</span></span></li>
<li class="reveal card story story-dark"><span class="story-t"><b>4</b></span><h3>Sexta, 10h, na sua agenda</h3><p>Com a origem: foi a cliente que confirmou.</p><span class="mini-slot"><b>sex 10:00 · Sala 1</b><span>Lívia · Axila, Meia perna</span><span class="slot-tag">Marcado pela IA</span></span></li>
</ol>
</div>
</section>

<section id="pix" class="section bg-white deco">
<span class="rings-corner" aria-hidden="true"></span>
<div class="wrap split">
<div class="stack reveal">
<p class="eyebrow">Sinal por Pix</p>
<h2 class="h3s">Marcou, pagou o sinal, garantiu.</h2>
<p class="lead">Nos serviços que você escolher, a cliente paga o sinal ali mesmo na conversa. O dinheiro cai direto na sua conta. O Tredane não toca nele.</p>
<div class="mini-grid">
<div><h3>Valor por serviço</h3><p>Fixo ou percentual, só onde você quiser.</p></div>
<div><h3>Regras à vista</h3><p>A cliente lê a política de cancelamento antes de pagar.</p></div>
</div>
</div>
<div class="pix-stage">
<div class="pix scene-pix" role="img" aria-label="Ilustração: mensagem pedindo sinal de R$ [valor] por Pix para limpeza de pele na quinta às 14:00, com prazo de 2 horas; aguardando sinal e, depois, sinal pago com horário garantido.">
<p class="card pix-msg">Para garantir sua limpeza de pele na <strong>quinta 12/11 às 14:00</strong>, o sinal é de R$ [valor] por Pix. Pague em até 2 horas. Cancelamento com devolução até 24 h antes.</p>
<span class="pix-link" aria-hidden="true"></span>
<p class="card pix-status"><span><span class="dot"></span>Aguardando sinal · 1 h 52 min</span><span>conta da clínica</span></p>
<span class="pix-link" aria-hidden="true"></span>
<p class="pix-paid"><span class="pix-tick"><Icon name="check" size={16} stroke={2.8} /></span>Sinal pago · quinta 14:00 garantida</p>
</div>
</div>
</div>
</section>

<section id="confianca" class="panel-wrap bg-white">
<div class="wrap">
<div class="panel aurora-panel">
<span class="aurora" aria-hidden="true"><i></i><i></i></span>
<svg class="silk" aria-hidden="true" viewBox="0 0 1440 800" preserveAspectRatio="xMidYMid slice" fill="none" stroke-linecap="round" stroke-width="1.2"><g stroke="#9FD3D1" set:html={silkCool} /></svg>
<div class="panel-top reveal">
<div class="stack" style="gap: 16px;"><p class="eyebrow">Pode confiar</p><h2 class="h3s">Uma parceira que joga do seu lado.</h2></div>
<p class="lead">Fala com as frases da clínica e nunca decide pela cliente. Se ela pergunta se fala com um robô, ouve a verdade. E a responsável pausa as marcações automáticas com um botão.</p>
</div>
<ul class="feats plain">
{trust.map((f) => (
<li class="reveal"><span class="oi"><Icon name={f.icon} size={22} /></span><h3>{f.title}</h3><p>{f.text}</p></li>
))}
</ul>
</div>
</div>
</section>

<section id="equipe" class="section bg-cream">
<div class="wrap split team">
<div class="stack">
<div class="head reveal">
<p class="eyebrow">Feito para equipe</p>
<h2 class="h3s">Toda a equipe na mesma conversa e na mesma agenda.</h2>
<p class="lead">Quem precisa de alguém aparece primeiro. Quem assume, as outras veem. E cada horário entra na sala certa.</p>
</div>
<ul class="facts plain">
<li class="reveal"><Icon name="zap" size={22} /><strong>Atualiza na hora.</strong> Toda a equipe vê sem recarregar.</li>
<li class="reveal"><Icon name="phone" size={22} /><strong>No navegador do celular.</strong> Sem app de loja; avisa conversa nova.</li>
<li class="reveal"><Icon name="users" size={22} /><strong>Papéis claros.</strong> A responsável configura; as atendentes atendem.</li>
<li class="reveal"><Icon name="shield" size={22} /><strong>Dados separados.</strong> Nosso suporte só entra com a sua aprovação, por 30 minutos.</li>
</ul>
</div>
<div class="team-shot reveal">
<span class="disc" aria-hidden="true"></span>
<div class="stage-phone light"><Image src={shotConversas} alt={shotListAlt} widths={[280, 560]} sizes="280px" width={280} height={580} format="webp" quality={80} loading="lazy" decoding="async" /></div>
<p class="fine">Tela do aplicativo, com dados fictícios.</p>
</div>
</div>
</section>

<section id="piloto" class="section bg-cream" style="padding-top: 0;">
<div class="wrap">
<div class="panel apricot">
<span class="orb" aria-hidden="true"></span>
<span class="orb orb-2" aria-hidden="true"></span>
<svg class="flower" aria-hidden="true" viewBox="0 0 400 400" fill="none" stroke-width="1.2" set:html={flower} />
<div class="pilot-top panel-inner">
<div class="pilot-copy reveal">
<p class="eyebrow">Piloto aberto</p>
<h2 class="h2">Sua clínica merece crescer. Vamos começar?</h2>
<p class="lead">A gente conecta o WhatsApp, cadastra seus serviços com você e fica por perto nos primeiros passos.</p>
{(hasWhatsapp || hasContact) ? (
<div class="cta-row">
{hasWhatsapp && <a class="btn btn-dark" href={whatsappUrl}><Icon name="message" size={20} stroke={2.2} />Chamar no WhatsApp</a>}
{hasContact && <a class={hasWhatsapp ? 'pilot-mail' : 'btn btn-dark'} href={`mailto:${contactEmail}?subject=Piloto%20Tredane`}>{hasWhatsapp ? 'Prefiro e-mail' : 'Falar com o Tredane'}</a>}
</div>
) : <p class="pilot-pending">O canal de contato do piloto será informado aqui quando estiver disponível.</p>}
<span class="fine">Condições do piloto: [A DEFINIR]</span>
</div>
<div class="pilot-person reveal">
<span class="pilot-photo" aria-hidden="true">[foto]</span>
<p><strong>[A DEFINIR: nome de quem acompanha o piloto]</strong><span>Fica com a sua clínica do primeiro dia em diante, no mesmo WhatsApp.</span></p>
</div>
</div>
<div class="grid2 pilot-lists">
<div class="pilot-box reveal"><h3>A clínica recebe</h3><ul><li>Ajuda para conectar o WhatsApp</li><li>Serviços, preços e agenda configurados junto com você</li><li>Contato direto com quem constrói o produto</li></ul></div>
<div class="pilot-box reveal"><h3>O que pedimos</h3><ul><li>Um número de WhatsApp Business da clínica</li><li>Sua lista de serviços, profissionais e salas</li><li>Uma conta Pix da clínica, se quiser usar o sinal</li><li>Conversas rápidas sobre o que funcionou</li></ul></div>
</div>
</div>
</div>
</section>

<section id="perguntas" class="section" style="padding-top: 0;">
<div class="wrap split" style="align-items: start;">
<div class="stack" style="gap: 16px;">
<p class="eyebrow">Perguntas frequentes</p>
<h2 class="h3s">Perguntas que a gente ouve.</h2>
{hasWhatsapp && hasContact && <p class="lead">Outra dúvida? <a href={whatsappUrl}>Pergunte no WhatsApp</a> ou <a href={`mailto:${contactEmail}`}>por e-mail</a>.</p>}
{hasWhatsapp && !hasContact && <p class="lead">Outra dúvida? <a href={whatsappUrl}>Pergunte no WhatsApp</a>.</p>}
{!hasWhatsapp && hasContact && <p class="lead">Outra dúvida? <a href={`mailto:${contactEmail}`}>Escreva para a gente</a>.</p>}
</div>
<div class="faq">
{faq.map((item) => (
<details class="card reveal">
<summary>{item.q}<svg class="pm" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></summary>
<p>{item.a}</p>
</details>
))}
</div>
</div>
</section>
</main>

<footer class="footer">
<div class="wrap">
<div class="footer-top">
<img src="/tredane-horizontal-cor.svg" alt="Tredane" width="105" height="24" />
<nav class="footer-links" aria-label="Rodapé">
{hasAppUrl && <a href={appUrl}>Entrar</a>}
<a href="/privacidade">Política de privacidade</a>
<a href="/eliminacao-de-dados">Exclusão de dados</a>
{hasContact && <a href={`mailto:${contactEmail}`}>Contato</a>}
</nav>
</div>
<div class="footer-legal" aria-label="Informações legais">
<span>© 2026 Tredane. Tredane é um serviço da Lucimark.</span>
<span>Razão social: LUCIMARK INOVA SIMPLES (I.S.) · CNPJ: 66.552.736/0001-80</span>
<span>Endereço: Condomínio Ouro Vermelho II, Setor Habitacional Jardim Botânico, Brasília - DF, CEP 71680-385</span>
<span>Telefone: <a href="tel:+556181882769">(61) 8188-2769</a> · <a href="https://tredane.com">tredane.com</a></span>
</div>
</div>
</footer>

<script>
// Header fixo e animações (05/11/2026, ver docs/product/landing.md). Sem script, ou com menos
// movimento pedido pelo aparelho, nada fica escondido: o CSS só esconde sob html.js-ready.
const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
const bar = document.querySelector('.topbar')
const hero = document.getElementById('topo')
if (bar && hero && 'IntersectionObserver' in window) {
  new IntersectionObserver(([e]) => bar.classList.toggle('is-stuck', !e.isIntersecting), { rootMargin: '-80px 0px 0px 0px' }).observe(hero)
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('.nav a[href^="#"]')].map((a) => [a.hash.slice(1), a]),
  )
  const spy = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue
        links.forEach((a) => a.classList.remove('is-active'))
        links.get(e.target.id)?.classList.add('is-active')
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  )
  document.querySelectorAll('main > section[id]').forEach((s) => spy.observe(s))
}
if (!reduce && 'IntersectionObserver' in window) {
  document.documentElement.classList.add('js-ready')
  const reveal = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue
        e.target.classList.add('is-in')
        reveal.unobserve(e.target)
      }
    },
    { threshold: 0.15 },
  )
  document.querySelectorAll<HTMLElement>('.reveal').forEach((el) => {
    const siblings = [...(el.parentElement?.children ?? [])].filter((c) => c.classList.contains('reveal'))
    el.style.transitionDelay = `${Math.max(0, siblings.indexOf(el)) * 80}ms`
    el.addEventListener('transitionend', () => (el.style.transitionDelay = ''), { once: true })
    reveal.observe(el)
  })
  const scenes = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue
        e.target.classList.add('play')
        scenes.unobserve(e.target)
      }
    },
    { threshold: 0.4 },
  )
  document.querySelectorAll('.scene-pratica, .scene-pix').forEach((el) => scenes.observe(el))
}
</script>
</Base>
