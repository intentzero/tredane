---
import Base from '../layouts/Base.astro'

const appUrl = import.meta.env.PUBLIC_APP_URL
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL
const hasAppUrl = Boolean(appUrl && !appUrl.includes('.example'))
const hasContact = Boolean(contactEmail && !contactEmail.includes('.example'))
const contactHref = hasContact ? `mailto:${contactEmail}?subject=Piloto%20Tredane` : undefined
const steps = [
  { number: '01', title: 'A cliente chama', text: 'Ela escreve para o WhatsApp da clínica e pergunta pelo serviço ou por um horário.' },
  { number: '02', title: 'Recebe uma proposta', text: 'O atendimento usa o cadastro da clínica e apresenta uma opção de horário para ela avaliar.' },
  { number: '03', title: 'Confirma com um toque', text: 'A marcação depende do botão Confirmar. Nesse momento, a disponibilidade é conferida novamente.' },
]
const assurances = [
  { title: 'A equipe pode assumir', text: 'Se a cliente pedir uma pessoa, a conversa passa para a equipe e a automação é pausada naquele atendimento.' },
  { title: 'Preço vem do cadastro', text: 'Serviços, duração e valores partem das informações configuradas pela clínica. Sem valor cadastrado, não se inventa um.' },
  { title: 'A clínica mantém o controle', text: 'A responsável define os serviços e a agenda. A proposta só vira marcação após a confirmação da cliente e uma nova checagem.' },
]
const faq = [
  { q: 'A cliente consegue falar com uma pessoa?', a: 'Sim. O fluxo prevê a opção Falar com a equipe. Quando a cliente a escolhe, a equipe assume a conversa.' },
  { q: 'Uma mensagem escrita confirma o horário?', a: 'Não. A proposta apresenta serviço, dia, hora e valor. A cliente precisa tocar no botão Confirmar, e a disponibilidade é conferida de novo.' },
  { q: 'Como funciona o piloto?', a: 'A seleção, as condições e os valores do piloto ainda serão informados. A demonstração desta página ilustra o fluxo proposto; não representa uma clínica em operação.' },
]
---
<Base title="Tredane — atendimento e agenda para clínicas de estética e depilação" description="A cliente marca pelo WhatsApp. A recepção respira. Conheça o fluxo de atendimento, proposta e confirmação do Tredane para clínicas de estética e depilação.">
  <a class="skip" href="#conteudo">Ir para o conteúdo</a>
  <header class="topbar"><div class="wrap">
    <a class="brand" href="#topo" aria-label="Tredane, início"><img src="/tredane-horizontal-escuro.svg" alt="Tredane" width="120" height="26" /></a>
    <nav class="nav" aria-label="Seções"><a href="#como">Como funciona</a><a href="#controle">Controle da clínica</a><a href="#perguntas">Perguntas</a></nav>
    <div class="top-actions">{hasAppUrl && <a class="top-link" href={appUrl}>Entrar</a>}<a class="btn btn-outline btn-sm" href="#piloto">Conhecer o piloto</a></div>
  </div></header>
  <main id="conteudo">
    <section id="topo" class="hero"><div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="chip"><span class="dot" aria-hidden="true"></span>Para clínicas de estética e depilação</p>
        <h1 class="h1">A cliente marca pelo WhatsApp. <em>A recepção respira.</em></h1>
        <p class="lead">Do primeiro contato à proposta de horário, o Tredane organiza a conversa. A cliente confirma com um toque; a equipe continua por perto quando é preciso.</p>
        <div class="cta-row"><a class="btn btn-apricot" href="#piloto">Conhecer o piloto <span aria-hidden="true">→</span></a><a class="hero-link" href="#como">Ver como funciona</a></div>
      </div>
      <div class="demo" aria-label="Exemplo ilustrativo do fluxo de conversa, proposta e confirmação">
        <div class="demo-head"><span class="demo-head-icon" aria-hidden="true">T</span><span><strong>Conversa no WhatsApp</strong><small>Exemplo ilustrativo</small></span></div>
        <div class="demo-body">
          <p class="demo-bubble">Oi! Tem horário para depilação na sexta?</p>
          <div class="demo-proposal"><span class="demo-label">Proposta de horário</span><strong>Sexta-feira · 10h</strong><span>Depilação · axila</span><span>Valor conforme o cadastro da clínica</span><span class="demo-confirm">Confirmar</span><span class="demo-secondary">Outro horário · Falar com a equipe</span></div>
        </div>
        <div class="demo-result"><span class="demo-check" aria-hidden="true">✓</span><span><strong>Horário na agenda</strong><small>Após o toque em Confirmar e nova checagem</small></span></div>
      </div>
    </div><div class="wrap"><p class="hero-note">Fluxo ilustrativo. Nomes, horários e telas não representam uma clínica real.</p></div></section>
    <section id="como" class="section journey"><div class="wrap">
      <div class="head"><p class="eyebrow">Como funciona</p><h2 class="h2">Uma conversa, três momentos claros.</h2><p class="lead">A cliente segue pelo WhatsApp; a clínica acompanha o atendimento e a agenda.</p></div>
      <ol class="journey-grid plain">{steps.map((step) => <li class="journey-step"><span class="journey-number">{step.number}</span><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol>
    </div></section>
    <section id="controle" class="section band"><div class="wrap trust-grid">
      <div class="head"><p class="eyebrow">Confiança no atendimento</p><h2 class="h2">Automação com espaço para a equipe.</h2><p class="lead">O fluxo foi desenhado para deixar explícito quando a cliente confirma e quando uma pessoa precisa continuar a conversa.</p></div>
      <ul class="trust-list plain">{assurances.map((item) => <li><span class="trust-mark" aria-hidden="true">✓</span><span><strong>{item.title}</strong><span>{item.text}</span></span></li>)}</ul>
    </div></section>
    <section id="piloto" class="panel-wrap pilot-section"><div class="wrap"><div class="panel petrol pilot-panel">
      <div class="head"><p class="eyebrow">Piloto Tredane</p><h2 class="h2">Vamos conversar sobre a rotina da sua clínica?</h2><p class="lead">O piloto é voltado a clínicas de estética e depilação. As condições de participação ainda serão definidas.</p>
        {hasContact ? <a class="btn btn-white" href={contactHref}>Falar com o Tredane</a> : <p class="pilot-pending">O canal de contato do piloto será informado aqui quando estiver disponível.</p>}
      </div>
    </div></div></section>
    <section id="perguntas" class="section faq-section"><div class="wrap faq-layout">
      <div class="head"><p class="eyebrow">Perguntas frequentes</p><h2 class="h2">Antes de começar.</h2></div>
      <div class="faq">{faq.map((item) => <details class="card"><summary>{item.q}<span aria-hidden="true" class="pm">+</span></summary><p>{item.a}</p></details>)}</div>
    </div></section>
  </main>
  <footer class="footer"><div class="wrap">
    <div class="footer-top"><img src="/tredane-horizontal-cor.svg" alt="Tredane" width="105" height="24" /><nav class="footer-links" aria-label="Rodapé"><a href="/privacidade">Política de privacidade</a><a href="/eliminacao-de-dados">Exclusão de dados</a>{hasContact && <a href={`mailto:${contactEmail}`}>Contato</a>}</nav></div>
    <div class="footer-legal"><span>© 2026 Tredane. Tredane é um serviço da Lucimark.</span><span>Razão social: LUCIMARK INOVA SIMPLES (I.S.) · CNPJ: 66.552.736/0001-80</span><span>Endereço: Condomínio Ouro Vermelho II, Setor Habitacional Jardim Botânico, Brasília - DF, CEP 71680-385</span><span>Telefone: <a href="tel:+556181882769">(61) 8188-2769</a> · <a href="https://lucimark.com" rel="noopener noreferrer">lucimark.com</a></span></div>
  </div></footer>
</Base>
