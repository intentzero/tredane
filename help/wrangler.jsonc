{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Central de ajuda pública, separada da landing e do painel (docs/product/ajuda.md). Só arquivos estáticos.
  // Deploy: npm run deploy:staging | deploy:production (em help/), ou Actions → Deploy ajuda.
  // Conta Cloudflare deve ser a que possui a zona tredane.com.
  "name": "tredane-ajuda",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist"
  },
  "workers_dev": true,
  "env": {
    "production": {
      "workers_dev": false,
      "routes": [{ "pattern": "ajuda.tredane.com", "custom_domain": true }]
    },
    "staging": {
      "workers_dev": true,
      "routes": [{ "pattern": "staging.ajuda.tredane.com", "custom_domain": true }]
    }
  }
}
