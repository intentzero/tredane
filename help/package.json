{
  "name": "tredane-ajuda",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-estado.mjs && astro build",
    "preview": "astro preview",
    "check": "node scripts/check-estado.mjs && astro check",
    "build:staging": "SITE_URL=https://staging.ajuda.tredane.com PUBLIC_NOINDEX=1 PUBLIC_APP_URL=https://staging.app.tredane.com HELP_DRAFTS=1 npm run build",
    "build:production": "SITE_URL=https://ajuda.tredane.com PUBLIC_APP_URL=https://app.tredane.com npm run build",
    "deploy:staging": "npm run build:staging && wrangler deploy --env staging",
    "deploy:production": "npm run build:production && wrangler deploy --env production"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/starlight": "0.43.1",
    "@fontsource/roboto": "5.3.0",
    "astro": "7.4.1",
    "sharp": "0.35.5",
    "starlight-links-validator": "0.27.0",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "wrangler": "4.136.1"
  }
}
