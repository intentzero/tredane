# Copie para .dev.vars (nunca versionar .dev.vars com segredos reais).
# F1 (#21): identidade Clerk no Worker. Sem Organizations e sem MFA no MVP.

# Modo de auth:
# - synthetic — Bearer synth:<user_id> para testes locais (DEFAULT se chaves ausentes em development)
# - clerk — authenticateRequest + Backend API reais; UI /entrar usa @clerk/react SignIn
AUTH_MODE=synthetic

# Obrigatórios quando AUTH_MODE=clerk (Dashboard Clerk → API Keys):
# CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# Exposto ao browser via GET /api/auth/client-config (só a publishable key).

# Opcional: PEM público para verificação JWT networkless (Dashboard → JWT public key)
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Origens autorizadas (CSRF / azp). Separadas por vírgula.
# Obrigatório em staging/production.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173

# Em staging/production (wrangler secret / dashboard), definir:
#   CLERK_PUBLISHABLE_KEY, CLERK_SECRET_KEY, CLERK_AUTHORIZED_PARTIES
#   AUTH_MODE=clerk (synthetic é ignorado/forçado a clerk nesses ambientes)
# Opcional: CLERK_JWT_KEY

# #25 — Convites por e-mail (provedor real ainda Em aberto / ADR-0008):
# APP_BASE_URL=http://localhost:5173
# EMAIL_TRANSPORT=simulated
# Quando houver provedor aprovado: configurar credenciais via wrangler secret
# (nunca versionar) e documentar política de dados antes de envio real.

# #31/#32 — WhatsApp Embedded Signup + webhooks (DEC-009). Default synthetic até gates Meta (#18):
# META_MODE=synthetic
# Em live (após App Review / Tech Provider): wrangler secret para
#   META_APP_ID, META_APP_SECRET, META_CONFIG_ID, META_TOKEN_SECRET, META_VERIFY_TOKEN
# META_GRAPH_API_VERSION=v25.0
# Em synthetic, verify token / app secret têm defaults de teste (ver webhook-verify.ts).
# Nunca versionar APP_SECRET, VERIFY_TOKEN de produção nem tokens de negócio.

# #37 — Pix / Woovi (DEC-049). Default synthetic até GATE-08 (DPA + chaves humanas):
# PIX_MODE=synthetic
# PIX_TOKEN_SECRET=...   # cifra App ID em repouso (opcional em synthetic)
# Em sandbox/live: App ID fica na conta da clínica (M-33), nunca no frontend.
# Nunca versionar App IDs reais nem misturar sandbox/produção.

# #41 — IA assistiva Claude via AI Gateway (DEC-011). Default synthetic até GATE-06:
# AI_MODE=synthetic
# Em gateway (após logging de payload desligado + não retenção Anthropic):
#   AI_MODE=gateway
#   CF_ACCOUNT_ID=...
#   AI_GATEWAY_ID=...
#   AI_GATEWAY_TOKEN=...   # wrangler secret
#   ANTHROPIC_API_KEY=...  # opcional BYOK
# Nunca versionar tokens. Dados reais só após revisão jurídica (GATE-04/06).

# #42 — PWA / Web Push (DEC-040). Default synthetic até VAPID em staging/prod:
# PUSH_MODE=synthetic
# Em live:
#   PUSH_MODE=live
#   VAPID_PUBLIC_KEY=...
#   VAPID_PRIVATE_KEY=...   # wrangler secret
#   VAPID_SUBJECT=mailto:ops@sua-clinica.example
# Nunca versionar a chave privada. O aviso de nova conversa não inclui o texto da mensagem.
