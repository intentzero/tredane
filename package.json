{
  "name": "tredane",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tredane — atendimento inteligente para clínicas de estética",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf:typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply tredane-dev --local",
    "db:seed:local": "wrangler d1 execute tredane-dev --local --file=./db/seed.sql",
    "db:generate": "drizzle-kit generate",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "hono": "4.11.1",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "4.20261017.0",
    "@eslint/js": "9.39.1",
    "@types/node": "22.18.12",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.2",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "7.1.12",
    "vitest": "4.0.16",
    "wrangler": "4.136.1"
  }
}
