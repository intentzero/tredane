{
  "name": "tredane",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tredane — atendimento inteligente para clínicas de estética",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:runtime": "vitest run --config vitest.runtime.config.ts",
    "check:design": "python3 docs/design/tools/check_contrast.py && python3 docs/design/tools/check_mocks.py && python3 docs/design/tools/check_css_vars.py",
    "check:env": "node scripts/check-env-placeholders.mjs",
    "ops:secrets": "node scripts/ops-secrets-inventory.mjs",
    "ops:smoke": "node scripts/ops-smoke-checklist.mjs",
    "ops:load": "node scripts/ops-synthetic-load.mjs",
    "mvp:evidence": "node scripts/mvp-evidence-check.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run test:runtime && npm run check:design && npm run build && npm run db:migrate:local && npm run db:seed:local && npm run check:env -- development && npm run ops:smoke && npm run mvp:evidence",
    "cf:typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply tredane-dev --local",
    "db:seed:local": "wrangler d1 execute tredane-dev --local --file=./db/seed.sql",
    "db:generate": "drizzle-kit generate",
    "deploy": "node scripts/deploy.mjs",
    "design:tokens": "python3 docs/design/tools/build_tokens.py && node scripts/sync-client-tokens.mjs",
    "prova:bundle": "node scripts/measure-prova-bundle.mjs"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@clerk/backend": "3.26.2",
    "@clerk/localizations": "4.24.3",
    "@clerk/react": "6.18.1",
    "@fontsource/inter": "5.3.0",
    "@internationalized/date": "3.12.4",
    "drizzle-orm": "0.45.4",
    "hono": "4.11.1",
    "lucide-react": "1.61.0",
    "react": "19.2.4",
    "react-aria-components": "1.22.1",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "^5.20261024.1",
    "@eslint/js": "9.39.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.18.12",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "axe-core": "4.14.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.2",
    "globals": "16.5.0",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "7.1.12",
    "vitest": "4.0.16",
    "wrangler": "4.152.0"
  }
}
